rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 自分(ログイン中のユーザー)のデータだけ読み書きできる。
    // それ以外のパスは、ルールに書かれていないのですべて拒否される。
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/gymlog_machines/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt is number;
    }

    match /users/{uid}/gymlog_sets/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['machineId', 'weight', 'reps', 'ts'])
        && request.resource.data.machineId is string
        && request.resource.data.weight is number
        && request.resource.data.weight >= 0
        && request.resource.data.weight <= 2000
        && request.resource.data.reps is number
        && request.resource.data.reps > 0
        && request.resource.data.reps <= 1000
        && request.resource.data.ts is number;
    }
  }
}
